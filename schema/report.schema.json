{
  "$defs": {
    "CatalogInfo": {
      "additionalProperties": false,
      "properties": {
        "frameworks": {
          "items": {
            "$ref": "#/$defs/FrameworkInfo"
          },
          "title": "Frameworks",
          "type": "array"
        },
        "owasp_version": {
          "title": "Owasp Version",
          "type": "string"
        }
      },
      "required": [
        "owasp_version",
        "frameworks"
      ],
      "title": "CatalogInfo",
      "type": "object"
    },
    "ControlRef": {
      "additionalProperties": false,
      "properties": {
        "baselines": {
          "description": "SP 800-53 Rev 5 baselines (LOW, MODERATE, HIGH, PRIVACY) that include this control; derived from the vendored resolved-profile catalogs; empty for CSF",
          "items": {
            "type": "string"
          },
          "title": "Baselines",
          "type": "array"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "control_id": {
          "title": "Control Id",
          "type": "string"
        },
        "framework": {
          "enum": [
            "nist-800-53r5",
            "nist-csf-2.0"
          ],
          "title": "Framework",
          "type": "string"
        },
        "relationship": {
          "enum": [
            "equal",
            "subset_of",
            "superset_of",
            "intersects_with"
          ],
          "title": "Relationship",
          "type": "string"
        },
        "risk_id": {
          "description": "The OWASP risk whose crosswalk mapping supplied this control",
          "title": "Risk Id",
          "type": "string"
        },
        "sp800_171r3_derived": {
          "description": "800-171r3 (derived via source 800-53 control): requirement numbers whose source controls include exactly this control. Derived, not an authored mapping",
          "items": {
            "type": "string"
          },
          "title": "Sp800 171R3 Derived",
          "type": "array"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "risk_id",
        "framework",
        "control_id",
        "title",
        "relationship",
        "confidence"
      ],
      "title": "ControlRef",
      "type": "object"
    },
    "CoverageRow": {
      "additionalProperties": false,
      "properties": {
        "check_ids": {
          "items": {
            "type": "string"
          },
          "title": "Check Ids",
          "type": "array"
        },
        "findings": {
          "title": "Findings",
          "type": "integer"
        },
        "risk_id": {
          "title": "Risk Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "Assessed (static)",
            "Not assessed (requires active analysis)",
            "Not assessed (no allowlist provided; review the server inventory)"
          ],
          "title": "Status",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "risk_id",
        "title",
        "status",
        "check_ids",
        "findings"
      ],
      "title": "CoverageRow",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "title": "Check Id",
          "type": "string"
        },
        "client": {
          "enum": [
            "claude_desktop",
            "claude_code",
            "cursor",
            "vscode",
            "windsurf",
            "generic"
          ],
          "title": "Client",
          "type": "string"
        },
        "controls": {
          "items": {
            "$ref": "#/$defs/ControlRef"
          },
          "title": "Controls",
          "type": "array"
        },
        "evidence": {
          "title": "Evidence",
          "type": "string"
        },
        "id": {
          "pattern": "^[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "project": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Claude Code project path when the server is project-scoped",
          "title": "Project"
        },
        "remediation": {
          "title": "Remediation",
          "type": "string"
        },
        "risk_ids": {
          "items": {
            "type": "string"
          },
          "title": "Risk Ids",
          "type": "array"
        },
        "server": {
          "title": "Server",
          "type": "string"
        },
        "severity": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Severity",
          "type": "string"
        },
        "source_path": {
          "title": "Source Path",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "check_id",
        "title",
        "severity",
        "risk_ids",
        "server",
        "client",
        "source_path",
        "evidence",
        "remediation"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FrameworkInfo": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "nist-800-53r5",
            "nist-csf-2.0"
          ],
          "title": "Id",
          "type": "string"
        },
        "source_sha256": {
          "title": "Source Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source_sha256"
      ],
      "title": "FrameworkInfo",
      "type": "object"
    },
    "InputRecord": {
      "additionalProperties": false,
      "properties": {
        "client": {
          "enum": [
            "claude_desktop",
            "claude_code",
            "cursor",
            "vscode",
            "windsurf",
            "generic"
          ],
          "title": "Client",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "servers": {
          "default": 0,
          "title": "Servers",
          "type": "integer"
        },
        "status": {
          "enum": [
            "ok",
            "parse_error",
            "read_error"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "path",
        "client",
        "status"
      ],
      "title": "InputRecord",
      "type": "object"
    },
    "ServerEntry": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "items": {
            "type": "string"
          },
          "title": "Args",
          "type": "array"
        },
        "client": {
          "enum": [
            "claude_desktop",
            "claude_code",
            "cursor",
            "vscode",
            "windsurf",
            "generic"
          ],
          "title": "Client",
          "type": "string"
        },
        "command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Env",
          "type": "object"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Headers",
          "type": "object"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "project": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Project path for Claude Code projects.<path>.mcpServers entries",
          "title": "Project"
        },
        "raw_keys": {
          "items": {
            "type": "string"
          },
          "title": "Raw Keys",
          "type": "array"
        },
        "scope": {
          "default": "unknown",
          "enum": [
            "user",
            "project",
            "unknown"
          ],
          "title": "Scope",
          "type": "string"
        },
        "source_path": {
          "title": "Source Path",
          "type": "string"
        },
        "transport": {
          "default": "unknown",
          "enum": [
            "stdio",
            "http",
            "sse",
            "unknown"
          ],
          "title": "Transport",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "name",
        "client",
        "source_path"
      ],
      "title": "ServerEntry",
      "type": "object"
    },
    "Summary": {
      "additionalProperties": false,
      "properties": {
        "by_severity": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "title": "By Severity",
          "type": "object"
        },
        "total_findings": {
          "title": "Total Findings",
          "type": "integer"
        },
        "total_servers": {
          "title": "Total Servers",
          "type": "integer"
        }
      },
      "required": [
        "by_severity",
        "total_findings",
        "total_servers"
      ],
      "title": "Summary",
      "type": "object"
    },
    "ToolInfo": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "ToolInfo",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "catalog": {
      "$ref": "#/$defs/CatalogInfo"
    },
    "coverage": {
      "items": {
        "$ref": "#/$defs/CoverageRow"
      },
      "title": "Coverage",
      "type": "array"
    },
    "coverage_note": {
      "default": "Assessed (static) means at least one configuration-indicator check ran for the risk; it is not a complete assessment of the risk.",
      "title": "Coverage Note",
      "type": "string"
    },
    "disclaimer": {
      "title": "Disclaimer",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    },
    "inputs": {
      "items": {
        "$ref": "#/$defs/InputRecord"
      },
      "title": "Inputs",
      "type": "array"
    },
    "schema_version": {
      "const": "1.1",
      "default": "1.1",
      "title": "Schema Version",
      "type": "string"
    },
    "servers": {
      "items": {
        "$ref": "#/$defs/ServerEntry"
      },
      "title": "Servers",
      "type": "array"
    },
    "summary": {
      "$ref": "#/$defs/Summary"
    },
    "tool": {
      "$ref": "#/$defs/ToolInfo"
    }
  },
  "required": [
    "tool",
    "generated_at",
    "catalog",
    "disclaimer",
    "inputs",
    "servers",
    "findings",
    "coverage",
    "summary"
  ],
  "title": "mcp-crosswalk scan report",
  "type": "object"
}

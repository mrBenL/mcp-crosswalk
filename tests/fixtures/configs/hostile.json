{
  "mcpServers": {
    "<script>alert(1)</script>": {
      "command": "<img src=x onerror=alert(2)>",
      "args": ["\"><script>alert(3)</script>", "/"],
      "env": {"NOTE": "</td></tr><script>alert(4)</script>"}
    },
    "evil&amp;\"quote'": {
      "url": "http://evil.example.com/sse?x=<b>bold</b>",
      "headers": {"X-Note": "<style>body{display:none}</style>"}
    },
    "unicode-\u202e-rtl": {
      "command": "node",
      "args": ["server.js", "[link](javascript:alert(5))"]
    },
    "not-an-object": "ignored",
    "numbers": {"command": 42, "args": [1, true, null, {"k": "v"}], "env": {"N": 1}},
    "args-string": {"command": "node", "args": "single-arg.js"}
  }
}
